# The toolchain image this project builds in, pinned by digest: the
# freestanding image from the odi-toolchain repository
# (https://github.com/AndreZiviani/odi-toolchain), Debian gcc-mips-linux-gnu
# plus qemu-mips-static and the shared ISA audit. The one place that names
# it; the Makefile includes this file and scripts/toolchain-image.sh sources
# it, so it holds plain KEY=value lines only.
#
# To move the pin: take the digest from the summary of the odi-toolchain
# publish run for the new tag, change it here, rebuild, and compare the
# binary with the one the old pin produced -- identical, or every difference
# explained.
TOOLCHAIN_IMAGE_PINNED=ghcr.io/andreziviani/odi-toolchain-freestanding:v2@sha256:a0342d9662553d725b29be891d5647393f76768c7cf3decb34b4f4bb2e0de611
